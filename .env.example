# =============================================
# CODEX COFFEE SHOP — Environment Variables
# =============================================
# Copy file ini ke server/.env dan isi nilainya
# Jangan commit file .env ke GitHub!

# --- DATABASE ---
# Neon PostgreSQL (wajib untuk production/Vercel)
# Cara dapat: neon.tech → Project → Connection Details → Connection String
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Untuk lokal tanpa Neon: kosongkan DATABASE_URL, otomatis pakai SQLite
# DATABASE_URL=

# --- JWT AUTH ---
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman

# --- SERVER ---
PORT=5000
