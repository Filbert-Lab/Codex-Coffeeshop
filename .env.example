# =============================================
# CODEX COFFEE SHOP — Environment Variables
# =============================================
# Copy this file to server/.env and fill in the values.
# Never commit your real .env to GitHub.

# --- DATABASE ---
# Neon PostgreSQL (required for production / Vercel).
# Get it from: neon.tech → Project → Connection Details → Connection String
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local dev without Neon: leave DATABASE_URL empty to use SQLite.
# DATABASE_URL=

# --- JWT AUTH ---
# 32+ chars random string, e.g. `openssl rand -base64 48`
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman
# Optional: JWT lifetime (default 7d). Use ms-style or seconds.
# JWT_EXPIRY=7d

# --- SERVER ---
PORT=5000
# Comma-separated list of allowed origins in production (CORS allowlist).
# ALLOWED_ORIGINS=https://your-domain.vercel.app

# =============================================
# WEBRTC TURN SERVER (client-side — set in Vercel, not server/.env)
# =============================================
# A TURN relay server is REQUIRED for WebRTC calls to work when either
# peer is behind symmetric NAT, CGNAT (mobile networks), or a strict
# firewall. STUN alone is not enough.
#
# Get free TURN credentials: https://www.metered.ca/stun-turn
# Then set these as Vercel env vars (prefixed VITE_ so Vite exposes them):
# VITE_TURN_URL=turn:your.turn.server:3478,turn:your.turn.server:3478?transport=tcp
# VITE_TURN_USERNAME=youruser
# VITE_TURN_CREDENTIAL=yourpass
#
# If left empty, falls back to free OpenRelay TURN (may be unreliable).

# =============================================
# OAUTH (optional — leave empty to disable a provider)
# =============================================
# Google OAuth 2.0 (https://console.cloud.google.com)
#   Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override the redirect URI if your deployment uses a different origin
# GOOGLE_CALLBACK_URL=https://your-domain.vercel.app/api/auth/google/callback

# GitHub OAuth (https://github.com/settings/developers → New OAuth App)
#   Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://your-domain.vercel.app/api/auth/github/callback

# Where to redirect the browser after the OAuth callback completes.
# The auth server appends ?token=... (or ?error=...) before redirecting.
# Default is "/auth/callback" (the SPA picks the token up from the query).
# OAUTH_SUCCESS_REDIRECT=/auth/callback
# OAUTH_FAILURE_REDIRECT=/auth/callback
